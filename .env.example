# =============================================================================
#  Cotizador Concrehaus — variables de entorno
#  Copiar a `.env` y completar. NUNCA commitear el .env real.
# =============================================================================

# --- Registro de imágenes -------------------------------------------------
# De dónde tira las imágenes docker compose. Por defecto GHCR de este repo.
REGISTRY=ghcr.io/pel-matiasvaldivia/concrehaus
TAG=latest

# --- Dominio público ------------------------------------------------------
# El/los dominios con los que NPM publica la app (coma-separados, con https://).
# Necesario para que Next acepte los Server Actions detrás del proxy.
PUBLIC_ORIGIN=https://cotizador.concrehaus.com

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_PASSWORD=cambiar_este_password

# --- MinIO (storage S3 de planos) -----------------------------------------
MINIO_ROOT_USER=concrehaus
MINIO_ROOT_PASSWORD=cambiar_este_password_largo
S3_BUCKET=planos

# --- API de Claude (extracción de planos) ---------------------------------
# Crear la key en https://platform.claude.com  →  Settings → API keys → Create Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Modelo usado para leer los planos (opcional; por defecto claude-opus-5)
EXTRACTION_MODEL=claude-opus-5

# --- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=2
